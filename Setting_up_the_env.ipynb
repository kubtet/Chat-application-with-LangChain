   "source": [
    "### **Setting the API Key as an Environment Variable**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "a672b03f-bb2d-4d27-8f59-e4f234c37d27",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cd26e37e-0499-4c3b-8486-937d0bbbfff8",
   "metadata": {},
   "outputs": [],
   "source": [
    "os.environ.items()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "69901981-ed95-458c-b622-a213afbdf341",
   "metadata": {},
   "outputs": [],
   "source": [
    "for key, value in os.environ.items():\n",
    "    if key == 'OPENAI_API_KEY':\n",
    "        print(f\"{key}:{value}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "c420635e-a755-4faf-a55d-f26b5b63b0d0",
   "metadata": {},
   "outputs": [],
   "source": [
    "%load_ext dotenv\n",
    "%dotenv"
   ]
